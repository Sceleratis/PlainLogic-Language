{
  "name": "plainlogic",
  "displayName": "PlainLogic",
  "description": "Write PlainLogic with English steps, behavior aliases, native target blocks, and structural editor features.",
  "version": "0.3.0",
  "publisher": "plainlogic-local",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sceleratis/PlainLogic-Language.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "plainlogic",
    "pseudocode",
    "prose"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:plainlogic",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "plainlogic",
        "aliases": [
          "PlainLogic",
          "plainlogic"
        ],
        "extensions": [
          ".plog"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plainlogic",
        "scopeName": "source.plainlogic",
        "path": "./syntaxes/plainlogic.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "plainlogic",
        "path": "./snippets/plainlogic.json"
      }
    ],
    "commands": [
      {
        "command": "plainlogic.newDocument",
        "title": "PlainLogic: New Draft"
      },
      {
        "command": "plainlogic.showReference",
        "title": "PlainLogic: Open Language Reference"
      }
    ],
    "configuration": {
      "title": "PlainLogic",
      "properties": {
        "plainlogic.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local structural checks while editing. These do not interpret English or prove feasibility."
        }
      }
    },
    "configurationDefaults": {
      "[plainlogic]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js && python -B tools/package_agents.py --check",
    "test:integration": "node test/run-host.js",
    "test:checker": "python -B -m unittest discover -s test -p checker_test.py",
    "test:agent-build": "python -B -m unittest discover -s test -p agent_package_test.py",
    "agents:sync": "python -B tools/package_agents.py --sync",
    "agents:check": "python -B tools/package_agents.py --check",
    "package:agents": "python -B tools/package_agents.py --package",
    "prepackage": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\"",
    "package": "vsce package --no-dependencies --skip-license --out dist/plainlogic-0.3.0.vsix",
    "test:all": "npm test && npm run test:checker && npm run test:agent-build && npm run test:cases && npm run test:gold",
    "test:cases": "python -B -m unittest discover -s test -p case_to_tests_test.py",
    "test:gold": "python -B -m unittest discover -s test -p gold_conversions_test.py"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
